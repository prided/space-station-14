cmd-ftldisk-desc = Crea un disco de coordenadas FTL para viajar al mapa en el que está el EntityID indicado.

cmd-ftldisk-help = ftldisk [EntityID]

cmd-ftldisk-no-transform = ¡La entidad {$destination} no tiene un componente Transform!

cmd-ftldisk-no-map = ¡La entidad {$destination} no tiene mapa!

cmd-ftldisk-no-map-comp = La entidad {$destination} está de algún modo en el mapa {$map} sin un componente de mapa.

cmd-ftldisk-map-not-init = ¡La entidad {$destination} está en el mapa {$map}, que no está inicializado! Comprueba que sea seguro hacerlo e inicializa primero el mapa; de lo contrario, los jugadores quedarán inmovilizados.

cmd-ftldisk-map-paused = ¡La entidad {$desintation} está en el mapa {$map}, que está pausado! Reanuda primero el mapa; de lo contrario, los jugadores quedarán inmovilizados.

cmd-ftldisk-planet = La entidad {$desintation} está en el mapa planetario {$map} y necesitará un punto FTL. Es posible que ya exista.

cmd-ftldisk-already-dest-not-enabled = ¡La entidad {$destination} está en el mapa {$map}, que ya tiene un FTLDestinationComponent, pero no está habilitado! Habilítalo manualmente por seguridad.

cmd-ftldisk-requires-ftl-point = ¡La entidad {$destination} está en el mapa {$map}, que requiere un punto FTL para viajar! Es posible que ya exista.

cmd-ftldisk-hint = netID del mapa
