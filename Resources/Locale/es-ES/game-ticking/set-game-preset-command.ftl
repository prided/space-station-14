set-game-preset-command-description = Configura el preajuste del juego para la ronda actual.
set-game-preset-command-help-text = Uso: setgamepreset <id>
set-game-preset-preset-error = No encuentro el preajuste del juego "{ $preset }"
set-game-preset-preset-set = Pon el preajuste del juego en "{ $preset }"

set-game-preset-command-hint-1 = <id>

set-game-preset-command-hint-2 = [number of rounds]

set-game-preset-command-hint-3 = [decoy preset]

set-game-preset-optional-argument-not-integer = Si se proporciona el argumento 2, debe ser un número.

set-game-preset-decoy-error = Si se proporciona el argumento 3 debe ser un preset válido. Incapaz de encontrar el preset del juego "{$preset}"

set-game-preset-preset-set-finite = Se estableció el modo de juego "{$preset}" para las próximas {$rounds} rondas.

set-game-preset-preset-set-finite-with-decoy = Se estableció el modo de juego "{$preset}" para las próximas {$rounds} rondas; se mostrará {$decoy} en la sala de espera.
